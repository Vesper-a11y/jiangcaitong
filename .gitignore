# 构建产物
android/build/
android/dist/

# 本地依赖（2026-11-23）。只有冒烟测试用得到 jsdom，装一次 18MB、1400 多个文件。
# 🔴 之前它被误提交进仓库了（占全部文件的九成），开源前必须挡住：
#    别人的 npm install 会自己装，不需要我们替他保存。
node_modules/
# 打包中途失败时，整个 build/ 会被挪开避开批量删除守卫（build_stale_日期）。
# 只忽略 build/ 的话，这些挪开的目录就成了未跟踪项，每次 git status 都冒出来。
android/build_stale*/
__pycache__/
*.pyc
*.pyo

# 本机的 Android SDK / build-tools / JDK（2026-11-23）。
# 一整套一个多 G，全是公开可下载的东西，进仓库只会把 .git 撑爆。
# build_apk.py 按「HYT_SDK 环境变量 → .work-hangyuantong/_lab/out/sdk →
# 上一层的 _lab/out/sdk」这三处找，所以放哪一层都行。
_lab/

# 签名密钥只在本地，绝不进仓库（丢了就只能卸载重装）
*.keystore
*.jks

# 本机临时文件
*.log
.DS_Store
Thumbs.db

# 测试版清单（2026-11-06）：`build_apk.py --beta` 写的那个。
# 它是「这一版测试包有多大、哈希多少」的留档，只在打测试版的那台机器上有意义。
# 🔴 千万别把它提交上去 —— `check_beta.py` 有一条判据是「仓库里不该有
#    residue 的 beta.json」，有的话说明上一次测试版没收尾（版本号和渠道还停在
#    beta 状态），而那种状态下一旦误打正式包，就会被打包脚本拦下来。
beta.json

# 鸿蒙（2026-11-14）：下面这些全是本机的，进仓库只会给别人添乱。
# local.properties 里是**这台机器**的 SDK 绝对路径；.sign 里是从 SDK 里
# 导出来的证书链和签好的 profile —— 都不是我们的东西，也不该由我们保管。
harmony/local.properties
harmony/.sign/
harmony/entry/build/
harmony/entry/.preview/
harmony/build/
harmony/.hvigor/
harmony/.cxx/
harmony/oh_modules/
harmony/node_modules/
# 🔴 网页资源是**拷**进来的（`build_hap.py --copy`），不进仓库。
#    进来的话仓库里就有第二份 app.js —— 改了真的那份、忘了这份，
#    打出来的包还是旧的，而「我的」里版本号看着是新的。Android 侧同理，
#    它的副本在 android/build/ 底下，本来就被忽略。
harmony/entry/src/main/resources/rawfile/web/

# 教务真实页面样本（2026-11-23 体检时补上）。
# 这些文件是**真实登录状态**下抓下来的成绩 / 课表 / 考试页面，
# 里面有真名、真学号、真分数。留着是为了写解析器时能对着真实结构改，
# 但任何情况下都不该进仓库 —— 一旦推到 GitHub，等于把自己的成绩单挂出去。
# 🔴 本地文件还在，只是不跟踪；删了想再要得重新抓。
jxufe_samples/
